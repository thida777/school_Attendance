<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows plain http:// only to the computer that runs Laravel (php artisan serve).
    10.0.2.2 = the computer, seen from the Android emulator.
    To test on a real phone on the same Wi-Fi, add the computer's IP here (e.g. 192.168.1.20)
    and put the same IP in config/Config.java.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
