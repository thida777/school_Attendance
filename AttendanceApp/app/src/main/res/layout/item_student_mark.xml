<?xml version="1.0" encoding="utf-8"?>
<!-- One student while marking: avatar | name + ID | ✓ ✗ switch (Figma: TeacherMarkStep2 row) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <!-- The student's photo on top of the initials (the photo is hidden when there is none) -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <TextView
                android:id="@+id/txtAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_present"
                android:gravity="center"
                android:textColor="@color/brand"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="SD" />

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                tools:text="Sok Dara" />

            <TextView
                android:id="@+id/txtSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:text="S-10A-001" />
        </LinearLayout>

        <!-- ✓ / ✗ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <ImageView
                android:id="@+id/btnPresent"
                android:layout_width="46dp"
                android:layout_height="38dp"
                android:contentDescription="@string/present"
                android:padding="9dp"
                android:src="@drawable/ic_check" />

            <ImageView
                android:id="@+id/btnAbsent"
                android:layout_width="46dp"
                android:layout_height="38dp"
                android:contentDescription="@string/absent"
                android:padding="9dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />
</LinearLayout>
