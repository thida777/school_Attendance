<?xml version="1.0" encoding="utf-8"?>
<!-- Class details (Figma: TeacherClassDetails): rate, Mark attendance, students with risk and parent, subjects -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Summary: name, grade, rate ring, Mark attendance -->
            <LinearLayout
                style="@style/Attendance.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtClassName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_main"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            tools:text="10A" />

                        <TextView
                            android:id="@+id/txtClassInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            tools:text="Grade 10 · Room 101 · 7 students" />

                        <TextView
                            android:id="@+id/txtHomeroom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_chip_brand"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/homeroom_badge"
                            android:textColor="@color/brand"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/ringRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:max="100"
                            app:indicatorSize="76dp"
                            app:trackColor="@color/border"
                            app:indicatorTrackGapSize="0dp"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="7dp" />

                        <TextView
                            android:id="@+id/txtRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/text_main"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="86%" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtRateLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="@string/attendance_rate"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMark"
                    style="@style/Widget.Attendance.BrandButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/mark_attendance"
                    app:icon="@drawable/ic_attendance"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <include layout="@layout/view_state_box" />

            <!-- Students -->
            <LinearLayout
                android:id="@+id/cardStudents"
                style="@style/Attendance.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtStudentsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Students (7)" />

                <!-- Rows are added in ClassDetailActivity -->
                <LinearLayout
                    android:id="@+id/studentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- My subjects in this class -->
            <LinearLayout
                style="@style/Attendance.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_subjects_here"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipSubjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
