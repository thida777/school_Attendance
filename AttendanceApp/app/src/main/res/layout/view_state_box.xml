<?xml version="1.0" encoding="utf-8"?>
<!-- Loading spinner, or an icon + message + Try again. Used by Classes, Class details and History. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stateBox"
    style="@style/Attendance.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <ProgressBar
        android:id="@+id/stateProgress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="@color/brand" />

    <ImageView
        android:id="@+id/stateIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_icon_tile"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:visibility="gone"
        app:tint="@color/brand" />

    <TextView
        android:id="@+id/stateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/retry"
        android:visibility="gone"
        app:cornerRadius="12dp" />
</LinearLayout>
