<?xml version="1.0" encoding="utf-8"?>
<!-- Personal information (read only: the admin manages these details on the website) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/personalRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Rows are added in PersonalInfoActivity -->
            <LinearLayout
                android:id="@+id/infoList"
                style="@style/Attendance.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_info_box"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="@string/admin_only_note"
                android:textColor="@color/info_text"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/info_text" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
