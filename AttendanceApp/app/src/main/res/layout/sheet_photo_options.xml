<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet after tapping the camera button: gallery, camera, remove -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/profile_photo"
        android:textColor="@color/text_main"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/optGallery"
        style="@style/Attendance.Row"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="20dp">

        <ImageView
            style="@style/Attendance.RowIcon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_image" />

        <TextView
            style="@style/Attendance.RowText"
            android:text="@string/photo_choose" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optCamera"
        style="@style/Attendance.Row"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="20dp">

        <ImageView
            style="@style/Attendance.RowIcon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_camera" />

        <TextView
            style="@style/Attendance.RowText"
            android:text="@string/photo_take" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optRemove"
        style="@style/Attendance.Row"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="20dp">

        <ImageView
            style="@style/Attendance.RowIcon"
            android:background="@drawable/bg_chip_present"
            android:backgroundTint="@color/absent_soft"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_trash"
            app:tint="@color/absent_text" />

        <TextView
            style="@style/Attendance.RowText"
            android:text="@string/photo_remove"
            android:textColor="@color/absent_text" />
    </LinearLayout>
</LinearLayout>
