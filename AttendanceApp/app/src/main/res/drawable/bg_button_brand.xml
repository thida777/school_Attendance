<?xml version="1.0" encoding="utf-8"?>
<!-- Main button: gradient teal to blue, with a ripple when pressed -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="315" android:startColor="@color/button_start" android:endColor="@color/button_end" />
        </shape>
    </item>
</ripple>
