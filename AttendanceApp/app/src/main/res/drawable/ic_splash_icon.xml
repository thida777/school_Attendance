<?xml version="1.0" encoding="utf-8"?>
<!--
    Logo for Android 12+'s own splash (shown for a moment before our SplashActivity).
    Android draws it 288dp wide and keeps only the middle circle, so the cap sits small in the centre.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="76dp" android:height="76dp" android:gravity="center" android:drawable="@drawable/ic_school" />
</layer-list>
