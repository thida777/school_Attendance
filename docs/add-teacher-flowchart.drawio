        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Nothing is saved&lt;/b&gt;&lt;br&gt;Pop-up opens again, typed values kept,&lt;br&gt;red message under each wrong box&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;e.g. &quot;The phone has already been taken.&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
