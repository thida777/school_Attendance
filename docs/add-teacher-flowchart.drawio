<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="add-teacher" name="Add teacher">
    <mxGraphModel dx="1200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Add a teacher – Student Attendance Analytics System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Website · School data → Teachers · only the admin can do this&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="130" y="10" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- Main column (centre x = 430) -->
        <mxCell id="start" value="Start&lt;br&gt;Admin is logged in" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Open &lt;b&gt;Teachers&lt;/b&gt; page (/teachers)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;list of teachers, classes, hours&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="User is admin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Click &lt;b&gt;+ Add teacher&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="380" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Pop-up form&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Name (Khmer) · Name (Latin)&lt;br&gt;Phone (used to log in)&lt;br&gt;Email (optional)&lt;br&gt;Telegram chat ID (optional)&lt;br&gt;Password (first password)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Admin fills in and clicks&lt;br&gt;&lt;b&gt;Save teacher&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="590" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Names and phone filled?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(checked by the browser)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="670" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Server cleans the data&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;phone → digits only (012 345 678 = 012345678)&lt;br&gt;email → small letters&lt;br&gt;empty email / Telegram → none&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="315" y="820" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;All rules OK?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;names filled · phone 8–12 digits, not used&lt;br&gt;email valid, not used · Telegram ID 5–20 digits&lt;br&gt;password 8+ characters&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="290" y="940" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;Save the new teacher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;role = Teacher&lt;br&gt;password stored encrypted (hash)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="1130" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="Green message &lt;b&gt;&quot;Teacher saved.&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the new teacher is in the list&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="1230" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="End&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the teacher can log in with&lt;br&gt;phone + password (website and app)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="335" y="1320" width="190" height="80" as="geometry" />
        </mxCell>

