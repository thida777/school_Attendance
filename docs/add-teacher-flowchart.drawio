        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p4" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Yes&lt;br&gt;send to server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d2" target="p5">
          <mxGeometry relative="1" as="geometry" />
