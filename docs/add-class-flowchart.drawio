<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="add-class" name="Add class">
    <mxGraphModel dx="1200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Add a class – Student Attendance Analytics System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Website · School data → Classes · only the admin can do this&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="130" y="10" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- Main column (centre x = 430) -->
        <mxCell id="start" value="Start&lt;br&gt;Admin is logged in" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Open &lt;b&gt;Classes&lt;/b&gt; page (/classes)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tabs by grade, search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="User is admin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Click &lt;b&gt;+ Add class&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="380" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Pop-up form&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Class name (e.g. 10C)&lt;br&gt;Grade (7–12)&lt;br&gt;Room (optional)&lt;br&gt;Homeroom teacher (optional)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Admin fills in and clicks&lt;br&gt;&lt;b&gt;Save class&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="580" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Name and grade filled?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(checked by the browser)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="660" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Server cleans the data&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;class name → capitals, no spaces at the ends&lt;br&gt;(10c = 10C)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="315" y="810" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;All rules OK?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;name filled, not used in this school year&lt;br&gt;grade between 7 and 12 · room max 20&lt;br&gt;homeroom teacher is a teacher&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="290" y="900" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;Save the class&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;in the current school year (2026-2027)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="1090" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="Green message &lt;b&gt;&quot;Class saved.&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the new class is in the list (0 students)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="1180" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="1270" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Errors (left) -->
        <mxCell id="e0" value="&quot;No permission&quot; page&lt;br&gt;(403)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;teachers see only their own classes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="275" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Browser bubble:&lt;br&gt;&quot;Please fill in this field.&quot;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(Khmer page: សូមបញ្ចូល …)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="685" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Nothing is saved&lt;/b&gt;&lt;br&gt;Pop-up opens again, typed values kept,&lt;br&gt;red message under each wrong box&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;e.g. &quot;The class name has already been taken.&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="935" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Next steps -->
        <mxCell id="n1" value="&lt;b&gt;Next (to use the class)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Teaching Assignments: subjects + teachers&lt;br&gt;(&quot;Copy&quot; from a class of the same grade)&lt;br&gt;Students: add or move students into it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="610" y="1170" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="start" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p4" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" value="Yes&lt;br&gt;send to server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d2" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p5" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a9" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d3" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p7" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p7" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a13" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d1" target="e0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a14" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d2" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a15" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d3" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e1" target="p3">
