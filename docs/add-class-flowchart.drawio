        <mxCell id="b2" value="back to the form&lt;br&gt;(fix and save again)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e2" target="p3">
          <mxGeometry x="0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="975" /><mxPoint x="20" y="505" /></Array><mxPoint as="offset" /></mxGeometry>
