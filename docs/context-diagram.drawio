        <mxCell id="lblSysToParent" value="Absence alert&lt;br&gt;(absent 3 school days in a row),&lt;br&gt;Message from the school" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Times New Roman;fontSize=15;fontColor=#9933FF;" vertex="1" parent="1">
          <mxGeometry x="300" y="430" width="310" height="80" as="geometry" />
