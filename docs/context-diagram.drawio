<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="context-diagram" name="Context diagram (DFD level 0)">
    <mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Context Diagram (DFD Level 0)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="40" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- Process -->
        <mxCell id="sys" value="Student&lt;br&gt;Attendance&lt;br&gt;Analytics System" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="550" y="170" width="200" height="200" as="geometry" />
        </mxCell>

        <!-- External entities -->
        <mxCell id="admin" value="Admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Times New Roman;fontSize=28;" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="teacher" value="Teacher" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Times New Roman;fontSize=28;" vertex="1" parent="1">
          <mxGeometry x="1080" y="225" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="parent" value="Parent&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;(Telegram / SMS)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Times New Roman;fontSize=28;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Admin arrows -->
        <mxCell id="sysToAdmin" style="endArrow=classic;html=1;exitX=0;exitY=0.375;exitDx=0;exitDy=0;entryX=1;entryY=0.222;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adminToSys" style="endArrow=classic;html=1;exitX=1;exitY=0.778;exitDx=0;exitDy=0;entryX=0;entryY=0.625;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lblSysToAdmin" value="Dashboard, Insights, At-risk list,&lt;br&gt;Reports (Excel / PDF),&lt;br&gt;Correction requests, Audit log" style="text;html=1;align=center;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=15;fontColor=#9933FF;" vertex="1" parent="1">
          <mxGeometry x="225" y="160" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lblAdminToSys" value="Login, Users, Students, Parents,&lt;br&gt;Classes, Subjects, Teaching assignments,&lt;br&gt;Correction decisions, Follow-ups,&lt;br&gt;Attendance" style="text;html=1;align=center;verticalAlign=top;fontFamily=Times New Roman;fontSize=15;fontColor=#9933FF;" vertex="1" parent="1">
