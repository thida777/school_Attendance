        <!-- Teacher arrows -->
        <mxCell id="sysToTeacher" style="endArrow=classic;html=1;exitX=1;exitY=0.375;exitDx=0;exitDy=0;entryX=0;entryY=0.222;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="teacher">
