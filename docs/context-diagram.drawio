        <mxCell id="teacherToSys" style="endArrow=classic;html=1;exitX=0;exitY=0.778;exitDx=0;exitDy=0;entryX=1;entryY=0.625;entryDx=0;entryDy=0;" edge="1" parent="1" source="teacher" target="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lblSysToTeacher" value="Today's lessons, Student list,&lt;br&gt;Attendance history, Students to watch,&lt;br&gt;Parents asking for a call" style="text;html=1;align=center;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=15;fontColor=#9933FF;" vertex="1" parent="1">
          <mxGeometry x="745" y="160" width="330" height="80" as="geometry" />
