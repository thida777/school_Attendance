<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="website-login" name="Website login">
    <mxGraphModel dx="1200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Website login – Student Attendance Analytics System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;https://demohs-attendance.alwaysdata.net · admins and teachers (students and parents do not log in)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="130" y="10" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- Main column (centre x = 430) -->
        <mxCell id="start" value="Start&lt;br&gt;Open the website" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Already logged in?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(session or Remember me)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="170" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Login page&lt;/b&gt; (/login)&lt;br&gt;Phone number or email&lt;br&gt;Password · ☐ Remember me&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;English / ខ្មែរ button&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="320" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="User types and clicks &lt;b&gt;Log in&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="440" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Both boxes filled?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(checked by the browser)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="530" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="5 wrong tries in the last minute?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(same account + same computer)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="680" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Read the login&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;email → small letters&lt;br&gt;phone → digits only&lt;br&gt;(012 345 678 = 012345678)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="850" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Account found and&lt;br&gt;password correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="970" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;Login OK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;clear wrong tries · new session&lt;br&gt;save last login time&lt;br&gt;use the user's language (EN / ខ្មែរ)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="1120" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="Role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="355" y="1250" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="endAdmin" value="&lt;b&gt;Admin Dashboard&lt;/b&gt;&lt;br&gt;(/dashboard)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;whole school&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
