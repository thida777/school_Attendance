        <mxCell id="endTeacher" value="&lt;b&gt;My Dashboard&lt;/b&gt;&lt;br&gt;(/my-dashboard)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;only own classes&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="590" y="1260" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Error boxes (left) -->
        <mxCell id="e1" value="Browser bubble:&lt;br&gt;&quot;Please fill in this field.&quot;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(Khmer page: សូមបញ្ចូល …)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
