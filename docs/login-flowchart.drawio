        <mxCell id="e2" value="Error:&lt;br&gt;&quot;Too many attempts.&lt;br&gt;Try again in N seconds.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
