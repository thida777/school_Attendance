<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="take-attendance" name="Take attendance">
    <mxGraphModel dx="1200" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Take attendance – Student Attendance Analytics System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Website (Attendance → Take Attendance) and the teacher app use the same rules&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="130" y="10" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- Main column (centre x = 430) -->
        <mxCell id="start" value="Start&lt;br&gt;Teacher or admin is logged in" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Step 1 · Take Attendance&lt;/b&gt; (/attendance)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;today's lessons from the timetable&lt;br&gt;teacher: own lessons · admin: whole school&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="310" y="170" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Choose the lesson&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Start / Edit&lt;/b&gt; on a lesson card, or&lt;br&gt;&lt;b&gt;Other class or date&lt;/b&gt;: class, subject, date, period&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="270" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Date in the future?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="370" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="User is a teacher?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="490" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Teaches this class&lt;br&gt;and subject?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(Teaching Assignments)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="610" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="New lesson for &lt;b&gt;today&lt;/b&gt;, or&lt;br&gt;saved &lt;b&gt;less than 24 h&lt;/b&gt; ago?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="750" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="This period already&lt;br&gt;recorded for another subject?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="910" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Step 2 · Mark the students&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;active students of the class, all Present at first&lt;br&gt;tap &lt;b&gt;Absent&lt;/b&gt; · choose a reason (Sick, Permission …)&lt;br&gt;admin changing a lesson older than 24 h: write why&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="295" y="1060" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Step 3 · Review&lt;/b&gt; pop-up&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;present / absent count → &lt;b&gt;Submit&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="1170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="Changing a lesson older than&lt;br&gt;24 h &lt;b&gt;without a reason&lt;/b&gt;?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(server checks all rules again)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="1260" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;Save&lt;/b&gt; (all or nothing)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the lesson + one record per student&lt;br&gt;every change to a saved record → audit log&lt;br&gt;nothing is ever deleted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="315" y="1410" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="A student absent the &lt;b&gt;3rd&lt;/b&gt;&lt;br&gt;school day in a row,&lt;br&gt;no alert yet? &lt;font style=&quot;font-size:10px&quot;&gt;(today only)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="1520" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;Step 4 · Done&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;present / absent numbers, list of absent students,&lt;br&gt;button to the next lesson&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="315" y="1690" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="end" value="End&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rates, risk and dashboards update&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="1790" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Errors (left) -->
        <mxCell id="e1" value="&quot;Attendance cannot be taken&lt;br&gt;for a future date.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="70" y="385" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&quot;No permission&quot; (403)&lt;br&gt;&quot;You do not teach this subject&lt;br&gt;in this class.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="70" y="635" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;font style=&quot;font-size:10px&quot;&gt;Past day: &quot;Teachers can only take attendance for today. Ask the admin to correct a past day.&quot;&lt;br&gt;Older than 24 h: &quot;… Send a correction request from Attendance History.&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="50" y="765" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&quot;Period N on this day is already&lt;br&gt;recorded for [subject].&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="70" y="935" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="&lt;b&gt;Nothing is saved&lt;/b&gt;&lt;br&gt;&quot;Write why this past attendance&lt;br&gt;is being changed.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="70" y="1290" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Right side -->
        <mxCell id="adminNote" value="&lt;font style=&quot;font-size:10px&quot;&gt;Admin: any class,&lt;br&gt;today or a past day&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="495" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="alert" value="&lt;b&gt;Send 1 absence alert&lt;/b&gt; to the parent&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Telegram (with 3 answer buttons) or SMS&lt;br&gt;a message problem never stops the saving&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="610" y="1550" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="corr" value="&lt;b&gt;Later changes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;teacher after 24 h: correction request&lt;br&gt;→ admin approves or rejects&lt;br&gt;(Corrections &amp;amp; Audit Log)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="610" y="1690" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Arrows: main path -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="start" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d5" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p4" target="d6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a11" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d6" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p5" target="d7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a13" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d7" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d7" target="alert"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alert" target="p6">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="1670" /><mxPoint x="430" y="1670" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="a16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p6" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p6" target="corr"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Admin skips the teacher checks -->
        <mxCell id="a18" value="No (admin)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d5">
          <mxGeometry x="-0.85" relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="535" /><mxPoint x="620" y="890" /><mxPoint x="430" y="890" /></Array><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Arrows: errors -->
        <mxCell id="a19" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d1" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a20" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d3" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a21" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d4" target="e3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a22" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d5" target="e4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a23" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="d6" target="e5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Back to step 1 / step 2 -->
        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e1" target="p1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="415" /><mxPoint x="40" y="205" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e2" target="p1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="665" /><mxPoint x="30" y="205" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e3" target="p1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="810" /><mxPoint x="20" y="205" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="b4" value="back to step 1&lt;br&gt;with the message" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e4" target="p1">
          <mxGeometry x="0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="965" /><mxPoint x="10" y="205" /></Array><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="b5" value="back to step 2&lt;br&gt;(write the reason)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e5" target="p3">
          <mxGeometry x="0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="1320" /><mxPoint x="40" y="1100" /></Array><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="lg1" value="Start / End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="90" y="1900" width="100" height="36" as="geometry" /></mxCell>
        <mxCell id="lg2" value="Step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="230" y="1900" width="100" height="36" as="geometry" /></mxCell>
        <mxCell id="lg3" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="1894" width="100" height="48" as="geometry" /></mxCell>
        <mxCell id="lg4" value="Error message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="1900" width="100" height="36" as="geometry" /></mxCell>
        <mxCell id="lg5" value="Related flow" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="1900" width="100" height="36" as="geometry" /></mxCell>
      </root>
